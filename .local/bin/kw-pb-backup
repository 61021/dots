#!/usr/bin/env bash
# Nightly off-VPS copy of every PocketBase instance on myserver.
# Consistent data.db snapshots (sqlite online backup) + storage/, pb_migrations/, pb_hooks/,
# pulled to ~/backups/pocketbase with 14 hardlinked daily versions.
set -euo pipefail

VPS=myserver
DEST="$HOME/backups/pocketbase"
KEEP=14
today=$(date +%F)

ssh -o BatchMode=yes -o ConnectTimeout=15 "$VPS" python3 - <<'PY'
import pathlib, sqlite3, time
root = pathlib.Path.home() / 'pocketbase'
out = pathlib.Path.home() / 'pb-snapshots'
stamp = time.strftime('%Y-%m-%d')
for db in sorted(root.glob('*/pb_data/data.db')):
    name = db.parent.parent.name
    d = out / name
    d.mkdir(parents=True, exist_ok=True)
    tmp = d / f'.{stamp}.db'
    src = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
    dst = sqlite3.connect(tmp)
    src.backup(dst)
    ok = dst.execute('pragma integrity_check').fetchone()[0]
    dst.close(); src.close()
    if ok != 'ok':
        raise SystemExit(f'{name}: integrity_check said {ok}')
    tmp.rename(d / f'{stamp}.db')
    for old in sorted(d.glob('20*.db'))[:-7]:
        old.unlink()
    print(f'{name}: snapshot ok')
PY

mkdir -p "$DEST/daily"
work="$DEST/daily/$today.partial"
prev=$(ls -1d "$DEST"/daily/20??-??-?? 2>/dev/null | tail -1 || true)
link=()
[ -n "$prev" ] && link=(--link-dest="$prev")

for name in $(ssh -o BatchMode=yes "$VPS" 'for d in ~/pocketbase/*/pb_data; do basename "$(dirname "$d")"; done'); do
  mkdir -p "$work/$name"
  rsync -a --delete "${link[@]/%//$name}" \
    --include='/pb_data/' --include='/pb_data/storage/***' --include='/pb_migrations/***' --include='/pb_hooks/***' --exclude='*' \
    "$VPS:pocketbase/$name/" "$work/$name/"
  rsync -a "$VPS:pb-snapshots/$name/$today.db" "$work/$name/data.db"
done

rm -rf "$DEST/daily/$today"
mv "$work" "$DEST/daily/$today"
ln -sfn "daily/$today" "$DEST/latest"
ls -1d "$DEST"/daily/20??-??-?? | head -n -"$KEEP" | xargs -r rm -rf
du -sh "$DEST/daily/$today" | awk '{print "pocketbase backup: " $1}'
