;; -----------------------------------------------------------------------------
;; KW Top Bar, opened per monitor by ~/.config/eww/scripts/kw-bar-launch.sh
;; -----------------------------------------------------------------------------

;; --- data sources ------------------------------------------------------------

(defpoll bar-bat   :interval "30s" :initial '{"percent":0,"icon":"/home/khaled/.config/eww/icons/plug.svg","label":"--","state":"ok"}' "~/.config/eww/scripts/bar/battery.sh")
(defpoll bar-time  :interval "30s" :initial "--:--" "date '+%I:%M'")
(defpoll bar-date  :interval "60s" :initial ""      "date '+%a %d/%m'")

(deflisten net :initial '{"icon":"/home/khaled/.config/eww/icons/wifi-x.svg","label":"--","tip":"","state":"offline","radio":true,"conn":{"ssid":"","signal":0,"icon":"wifi-none","sec":false,"band":"","ip":"","sub":""},"busy":"","scanning":false}' "~/.config/eww/scripts/net/nm-listen.py")
(deflisten bar-audio  :initial '{"icon":"/home/khaled/.config/eww/icons/speaker-none.svg","label":"--","mic_muted":false}' "~/.config/eww/scripts/bar/audio-listen.sh")
(deflisten bar-workspaces :initial "[]" "~/.config/eww/scripts/bar/workspaces.py")

;; --- building blocks ---------------------------------------------------------

(defwidget bar-stat [icon text]
  (box :class "bar-stat" :orientation "h" :space-evenly false :spacing 6 :valign "center"
    (box :class "bar-icon" :valign "center" :style "background-image: url('${icon}');")
    (label :class "bar-text" :text text :show-truncated false)))

(defwidget bar-workspaces [monitor]
  (eventbox :onscroll "~/.config/eww/scripts/ws-scroll.sh {}"
    (box :class "bar-ws" :orientation "h" :space-evenly false :spacing 3 :valign "center"
      (for ws in bar-workspaces
        (eventbox :cursor "pointer" :visible {ws.monitor == monitor}
          (button :class "bar-ws-btn${ws.active ? " active" : ws.urgent ? " urgent" : ""}"
                  :tooltip "Workspace ${ws.id} - ${arraylength(ws.icons)} window${arraylength(ws.icons) == 1 ? "" : "s"}"
                  :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = ${ws.id} })'"
            (box :orientation "h" :space-evenly false :spacing 5 :halign "center" :valign "center"
              (for icon in {ws.icons}
                (box :class "bar-ws-app" :valign "center" :style "background-image: url('${icon}');"))
              (label :class "bar-ws-empty" :text "·" :visible {arraylength(ws.icons) == 0} :show-truncated false))))))))

(defwidget bar-left [monitor]
  (box :orientation "h" :space-evenly false :spacing 6 :halign "start" :valign "center"
    (eventbox :cursor "pointer"
      (button :class "bar-launcher"
              :tooltip "Control center (right-click: lock)"
              :onclick "~/.local/bin/kw-sound -v .6 -g 80 button-pressed & ~/.config/eww/scripts/kw-sidebar-toggle.sh &"
              :onrightclick "~/.local/bin/kw-lock --grace 0 &"
        (label :class "bar-launcher-text" :text "KW" :show-truncated false)))
    (bar-workspaces :monitor monitor)))

(defwidget bar-center []
  (box :orientation "h" :halign "center" :valign "center"
    (eventbox :cursor "pointer"
      (button :class "bar-clock-btn"
              :onclick "~/.local/bin/kw-sound -v .6 -g 80 button-pressed & ~/.config/eww/scripts/kw-calendar.sh &"
        (box :orientation "h" :space-evenly false :spacing 10 :valign "center"
          (label :class "bar-time" :text bar-time)
          (label :class "bar-date" :text bar-date))))))

(defwidget bar-right []
  (box :orientation "h" :space-evenly false :spacing 6 :halign "end" :valign "center"
    (systray :class "bar-tray" :spacing 8 :icon-size 16 :prepend-new true)
    (box :class "bar-group" :orientation "h" :space-evenly false :spacing 2 :valign "center"
      (eventbox :cursor "pointer" :visible {bar-audio.mic_muted}
        (button :class "bar-stat-btn bar-mic"
                :tooltip "Microphone is muted (click to unmute)"
                :onclick "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 && ~/.local/bin/kw-sound -u audio-volume-change"
          (box :class "bar-icon" :valign "center"
               :style "background-image: url('${EWW_CONFIG_DIR}/icons/microphone-slash-alert.svg');")))
      (eventbox :cursor "pointer" :onscroll "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%$([ '{}' = 'up' ] && echo + || echo -) && ~/.local/bin/kw-sound -u -g 200 audio-volume-change"
        (button :class "bar-stat-btn"
                :tooltip "Toggle mute (scroll to change volume)"
                :onclick "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && ~/.local/bin/kw-sound -u audio-volume-change"
                :onrightclick "~/.local/bin/kw-sound -v .6 -g 80 button-pressed & pavucontrol &"
          (bar-stat :icon {bar-audio.icon} :text {bar-audio.label})))
      (eventbox :cursor "pointer"
        (button :class "bar-stat-btn"
                :tooltip {net.tip}
                :timeout "2s"
                :onclick "~/.local/bin/kw-sound -v .6 -g 80 button-pressed & ~/.config/eww/scripts/kw-wifi.sh"
          (bar-stat :icon {net.icon} :text {net.label})))
      (box :class "bar-stat-btn bar-bat ${bar-bat.state}"
        (bar-stat :icon {bar-bat.icon} :text {bar-bat.label})))))

(defwidget kw-bar [monitor]
  (centerbox :class "kw-bar" :orientation "h"
    (bar-left :monitor monitor)
    (bar-center)
    (bar-right)))

;; --- window ------------------------------------------------------------------

;; Opened once per monitor by kw-bar-launch.sh:
;;   eww open bar --id bar-<name> --screen <gdk_idx> --arg monitor=<name> --size <w>x36
;; --screen binds the surface (GDK index, geometry-matched by the script);
;; the monitor arg is the HYPRLAND name, used only to filter workspace pills.
;; --size makes layer-shell reserve the full top edge; anchor must stay
;; top-center for that to work.
(defwindow bar [monitor]
  :stacking "fg"
  :exclusive true
  :focusable false
  :namespace "kw-bar"
  :geometry (geometry :x "0" :y "0" :width "100px" :height "36px" :anchor "top center")
  (kw-bar :monitor monitor))
