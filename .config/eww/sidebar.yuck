;; -----------------------------------------------------------------------------
;; KW Sidebar, toggled from the "KW" button in the bar
;; -----------------------------------------------------------------------------

;; --- data sources ------------------------------------------------------------

(defpoll kw-date      :interval "60s"  :initial '{"day":"","date":""}'                    "date '+{\"day\":\"%A\",\"date\":\"%-d %B\"}'")

(defpoll sys-stats    :interval "5s"   :initial '{"cpu":0,"mem":0,"temp":0}'              "~/.config/eww/scripts/sys-stats.sh")
(defpoll bat-detail   :interval "30s"  :initial '{"percent":-1,"status":"","charging":false,"time":"","health":0}' "~/.config/eww/scripts/battery-detail.sh")
(defpoll notif-hist   :interval "20s"  :initial "[]"                                      "~/.config/eww/scripts/kw-notif-history.sh")
(deflisten bar-player :initial '{"status":"","title":"","artist":"","art":""}' "~/.config/eww/scripts/bar/player-listen.py")

(defvar power-arm "")

;; Single JSON poll per service; eww parses the fields (vpn.class / vpn.tooltip).
;; kw-refresh.sh pushes instant state on click; the poll only catches external changes.
(defpoll vpn  :interval "15s" :initial '{"text":"VPN","class":"disconnected","tooltip":"VPN","alt":"disconnected"}'  "~/.config/eww/scripts/vpn.sh")
(defpoll metered :interval "15s" :initial '{"class":"disconnected","tooltip":"Data saver"}' "~/.config/eww/scripts/metered.sh")
(defpoll warp :interval "15s" :initial '{"text":"WARP","class":"disconnected","tooltip":"WARP","alt":"disconnected"}' "~/.config/eww/scripts/warp.sh")

(defpoll bt-state   :interval "20s" :initial "disconnected" "~/.config/eww/scripts/kw-state.sh bt")
(defpoll dnd-state  :interval "20s" :initial "connected"    "~/.config/eww/scripts/kw-state.sh dnd")
(defpoll eye-state  :interval "20s" :initial "disconnected" "~/.config/eww/scripts/kw-state.sh eye")
(defpoll tv-state   :interval "20s" :initial "disconnected" "~/.config/eww/scripts/kw-state.sh tv")

;; --- building blocks ---------------------------------------------------------

(defwidget kw-icon-button [icon tooltip onclick]
  (eventbox :cursor "pointer"
    (button
      :class "kw-icon-button"
      :tooltip tooltip
      :onclick onclick
      :style "background-image: url('${icon}');")))

;; Destructive power action: first click arms (red) for 3s, second executes.
(defwidget kw-power-button [action icon tooltip]
  (eventbox :cursor "pointer"
    (button
      :class "kw-icon-button danger${power-arm == action ? " armed" : ""}"
      :tooltip {power-arm == action ? "Click again to confirm" : tooltip}
      :onclick "~/.config/eww/scripts/kw-power.sh ${action}"
      :style "background-image: url('${icon}');")))

;; Quick-settings tile: icon, name and live state. `state` is the
;; connected/connecting/disconnected string every toggle source emits.
(defwidget kw-tile [icon label state onclick ?tooltip]
  (eventbox :cursor "pointer" :hexpand true
    (button
      :class "kw-tile ${state}"
      :tooltip {tooltip ?: label}
      :onclick onclick
      (box :orientation "h" :space-evenly false :spacing 10
        (box :class "kw-tile-icon" :valign "center"
             :style "background-image: url('${state == "connected" ? replace(icon, ".svg", "-active.svg") : icon}');")
        (box :orientation "v" :space-evenly false :valign "center"
          (label :class "kw-tile-label" :text label :xalign 0 :show-truncated false)
          (label :class "kw-tile-state" :xalign 0 :show-truncated false
                 :text {state == "connected" ? "On" : state == "connecting" ? "Connecting" : "Off"}))))))

(defwidget kw-header []
  (box :class "kw-header" :orientation "h" :space-evenly false
    (box :orientation "v" :space-evenly false :spacing 2 :hexpand true :valign "center"
      (label :class "kw-header-day" :text {kw-date.day} :xalign 0 :show-truncated false)
      (label :class "kw-header-date" :text {kw-date.date} :xalign 0 :show-truncated false))
    (eventbox :valign "center" :visible {bat-detail.percent >= 0}
              :tooltip "Battery health ${bat-detail.health}%"
      (box :class "kw-battery" :orientation "v" :space-evenly false :spacing 2
        (box :orientation "h" :space-evenly false :spacing 6 :halign "end"
          (box :class "kw-battery-icon" :valign "center" :style "background-image: url('${bar-bat.icon}');")
          (label :class "kw-battery-pct${bat-detail.charging ? " charging" : ""}"
                 :text "${bat-detail.percent}%" :show-truncated false))
        (label :class "kw-battery-time" :xalign 1 :limit-width 18 :show-truncated true
               :text {bat-detail.time != "" ? bat-detail.time : bat-detail.status})))))

(defwidget kw-ring [value unit label warn crit]
  (box :orientation "v" :space-evenly false :spacing 6 :halign "center"
    (overlay
      (circular-progress :class "kw-ring${value >= crit ? " crit" : value >= warn ? " warn" : ""}"
                         :value value :thickness 4 :start-at 75 :width 50 :height 50)
      (label :class "kw-ring-val" :text "${value}${unit}" :halign "center" :valign "center"))
    (label :class "kw-ring-label" :text label)))

(defwidget kw-sys-rings []
  (box :class "kw-ring-row" :orientation "h" :space-evenly true
    (kw-ring :value {sys-stats.cpu}                               :unit "%" :label "CPU"  :warn 80 :crit 92)
    (kw-ring :value {sys-stats.mem}                               :unit "%" :label "RAM"  :warn 80 :crit 92)
    (kw-ring :value {sys-stats.temp > 100 ? 100 : sys-stats.temp} :unit "°" :label "Temp" :warn 80 :crit 90)))

(defwidget kw-media []
  (box :class "kw-media" :orientation "h" :space-evenly false :spacing 12
       :visible {bar-player.status != ""}
    (box :class "kw-media-art${bar-player.art != "" ? "" : " empty"}" :valign "center"
         :style "background-image: url('${bar-player.art != "" ? bar-player.art : EWW_CONFIG_DIR + "/icons/music-notes.svg"}');")
    (box :orientation "v" :space-evenly false :spacing 6 :hexpand true :valign "center"
      (box :orientation "v" :space-evenly false :spacing 1
        (label :class "kw-media-title"  :text {bar-player.title}  :limit-width 20 :show-truncated true :xalign 0)
        (label :class "kw-media-artist" :text {bar-player.artist} :limit-width 26 :show-truncated true :xalign 0
               :visible {bar-player.artist != ""}))
      (box :class "kw-media-controls" :orientation "h" :space-evenly false :spacing 4 :halign "start"
        (eventbox :cursor "pointer"
          (button :class "kw-media-btn" :tooltip "Previous"
                  :onclick "playerctl previous"
                  :style "background-image: url('${EWW_CONFIG_DIR}/icons/skip-back.svg');"))
        (eventbox :cursor "pointer"
          (button :class "kw-media-btn kw-media-play" :tooltip {bar-player.status == "Playing" ? "Pause" : "Play"}
                  :onclick "playerctl play-pause"
                  :style "background-image: url('${EWW_CONFIG_DIR}/icons/${bar-player.status == "Playing" ? "pause" : "play"}-ink.svg');"))
        (eventbox :cursor "pointer"
          (button :class "kw-media-btn" :tooltip "Next"
                  :onclick "playerctl next"
                  :style "background-image: url('${EWW_CONFIG_DIR}/icons/skip-forward.svg');"))))))

(defwidget kw-notifications []
  (box :orientation "v" :space-evenly false :spacing 8
       :visible {arraylength(notif-hist) > 0}
    (box :orientation "h" :space-evenly false
      (label :class "kw-section-title" :xalign 0 :hexpand true :text "Notifications")
      (eventbox :cursor "pointer"
        (button :class "kw-notif-clear" :tooltip "Clear history"
                :onclick "dunstctl history-clear; ~/.config/eww/scripts/kw-refresh.sh notif"
          (label :text "Clear"))))
    (box :orientation "v" :space-evenly false :spacing 6
      (for n in notif-hist
        (box :class "kw-notif" :orientation "v" :space-evenly false :spacing 2
          (label :class "kw-notif-app"     :text {n.app}     :xalign 0 :limit-width 30 :show-truncated true)
          (label :class "kw-notif-summary" :text {n.summary} :xalign 0 :limit-width 32 :show-truncated true))))))

(defwidget kw-power-row []
  (box :class "kw-power-row" :orientation "h" :space-evenly true :spacing 6
    (kw-icon-button
      :icon "${EWW_CONFIG_DIR}/icons/lock-key.svg"
      :tooltip "Lock screen"
      :onclick "~/.config/eww/scripts/kw-sidebar-toggle.sh close & ~/.local/bin/kw-lock &")
    (kw-icon-button
      :icon "${EWW_CONFIG_DIR}/icons/moon-stars.svg"
      :tooltip "Suspend"
      :onclick "~/.config/eww/scripts/kw-sidebar-toggle.sh close & systemctl suspend &")
    (kw-power-button
      :action "reboot"
      :icon "${EWW_CONFIG_DIR}/icons/arrows-clockwise.svg"
      :tooltip "Reboot")
    (kw-power-button
      :action "poweroff"
      :icon "${EWW_CONFIG_DIR}/icons/power.svg"
      :tooltip "Power off")))

;; --- layout ------------------------------------------------------------------

(defwidget kw-sidebar []
  (box :class "kw-sidebar" :orientation "v" :space-evenly false :spacing 14
    (kw-header)
    (kw-sys-rings)

    (box :orientation "v" :space-evenly false :spacing 8
      (box :orientation "h" :space-evenly true :spacing 8
        (kw-tile
          :icon "${EWW_CONFIG_DIR}/icons/bluetooth.svg"
          :label "Bluetooth"
          :state bt-state
          :onclick "(rfkill list bluetooth | grep -q 'Soft blocked: no' && rfkill block bluetooth || rfkill unblock bluetooth); ~/.config/eww/scripts/kw-refresh.sh bt")
        (kw-tile
          :icon "${EWW_CONFIG_DIR}/icons/shield-check.svg"
          :label "VPN"
          :tooltip {vpn.tooltip}
          :state {vpn.class}
          :onclick "~/.config/eww/scripts/vpn-toggle.sh; ~/.config/eww/scripts/kw-refresh.sh vpn"))
      (box :orientation "h" :space-evenly true :spacing 8
        (kw-tile
          :icon "${EWW_CONFIG_DIR}/icons/cloud-check.svg"
          :label "WARP"
          :tooltip {warp.tooltip}
          :state {warp.class}
          :onclick "~/.config/eww/scripts/warp-toggle.sh")
        (kw-tile
          :icon "${EWW_CONFIG_DIR}/icons/gauge.svg"
          :label "Data saver"
          :tooltip {metered.tooltip}
          :state {metered.class}
          :onclick "~/.config/eww/scripts/metered.sh toggle &"))
      (box :orientation "h" :space-evenly true :spacing 8
        (kw-tile
          :icon "${EWW_CONFIG_DIR}/icons/bell.svg"
          :label "Notifications"
          :tooltip "Pause or resume notifications (dunst)"
          :state dnd-state
          :onclick "dunstctl set-paused toggle; ~/.config/eww/scripts/kw-refresh.sh dnd")
        (kw-tile
          :icon "${EWW_CONFIG_DIR}/icons/moon.svg"
          :label "Eye comfort"
          :tooltip "Warm screen, no blue light"
          :state eye-state
          :onclick "~/.config/eww/scripts/eye-comfort-toggle.sh; sleep 0.2 && ~/.config/eww/scripts/kw-refresh.sh eye"))
      (kw-tile
        :icon "${EWW_CONFIG_DIR}/icons/monitor.svg"
        :label "TV mode"
        :tooltip "Screen off, stay awake, stop charging. ALT+SHIFT+T exits"
        :state tv-state
        :onclick "~/.config/eww/scripts/tv-mode.sh toggle; ~/.config/eww/scripts/kw-refresh.sh tv"))

    (kw-media)
    (kw-notifications)

    (box :vexpand true)
    (kw-power-row)))

;; --- window ------------------------------------------------------------------

(defwindow kw-sidebar
  :stacking "overlay"
  :focusable false
  :namespace "kw-sidebar"
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "240px"
    :height "100%"
    :anchor "top left")
  (kw-sidebar))

;; Invisible full-surface backdrop under the sidebar (fg layer = below the
;; overlay-stacked sidebar; top-anchored so it never overlaps the bar):
;; clicking anywhere outside the sidebar dismisses it.
(defwindow kw-sidebar-bg
  :stacking "fg"
  :focusable false
  :namespace "kw-sidebar-bg"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top center")
  (eventbox :class "kw-backdrop"
            :onclick "~/.config/eww/scripts/kw-sidebar-toggle.sh close &"
    (box :hexpand true :vexpand true)))
