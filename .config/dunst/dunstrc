# KW notifications: slim one-line toasts under the right end of the bar.
# Palette: ~/stuff/constants/colors/palette.md

[global]
    font = "IBM Plex Sans Medium 10"
    markup = full
    # Title, then the body in the muted colour on the same line. dunst cannot
    # reveal the body on hover, so it stays inline and is cut with an ellipsis.
    format = "%s  <span foreground='#a1a1a1'>%b</span>"
    ignore_newline = true
    word_wrap = false
    ellipsize = end
    alignment = left
    vertical_alignment = center
    show_age_threshold = -1
    # Away from the keyboard toasts wait, so they are still there on return.
    idle_threshold = 2m

    origin = top-right
    offset = (18, 10)
    width = (0, 520)
    height = (0, 36)
    padding = 9
    horizontal_padding = 12
    text_icon_padding = 9
    gap_size = 6
    frame_width = 1
    frame_color = "#ffffff1a"
    corner_radius = 12
    highlight = "#fafafa"

    icon_position = left
    min_icon_size = 16
    max_icon_size = 16
    default_icon = /home/khaled/.config/dunst/icons/bell.svg

[experimental]
    pause_on_mouse_over = true

[urgency_low]
    background = "#000000"
    foreground = "#fafafa"
    timeout = 5s

[urgency_normal]
    background = "#000000"
    foreground = "#fafafa"
    timeout = 8s

[urgency_critical]
    background = "#000000"
    foreground = "#fafafa"
    default_icon = /home/khaled/.config/dunst/icons/warning.svg
    timeout = 15s

# Senders that ask for "never expire" (the battery notifier) still expire.
[kw-expire]
    match_dbus_timeout = 0
    override_dbus_timeout = 15s

# low-bat-notification.sh sends theme icon names; show the Phosphor one.
[kw-battery]
    appname = "battery"
    new_icon = /home/khaled/.config/dunst/icons/battery-warning.svg

[kw-sound]
    summary = "*"
    script = /home/khaled/.local/bin/kw-notif-sound
