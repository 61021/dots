/*****----- Clipboard history picker: minimal.rasi plus image thumbnails -----*****/
@theme "~/.config/rofi/minimal.rasi"

configuration {
    show-icons:          true;
}

window {
    width:               720px;
}

listview {
    lines:               6;
    fixed-height:        false;
}

element-icon {
    size:                64px;
}

/* Pinned rows (rofi -a): accent text, push-pin icon on text pins */
element normal.active,
element alternate.active,
element selected.active {
    text-color:          @accent;
}

entry {
    placeholder:         "Search clipboard…";
}

textbox-prompt-colon {
    str:                 "";
}
