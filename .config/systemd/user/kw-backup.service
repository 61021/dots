[Unit]
Description=restic backup of ~/stuff, ~/.claude + machine state to Cloudflare R2 (kw-restic)
# Repo password (~/.config/restic/password) and R2 keys (~/.config/restic/r2.env) are 0600; never commit them to dots.

[Service]
EnvironmentFile=%h/.config/restic/r2.env
Environment=RESTIC_REPOSITORY=s3:https://2ecfb65ac837bf16bb96da2c6d1ea96e.r2.cloudflarestorage.com/kw-restic
Type=oneshot
Nice=10
IOSchedulingClass=idle
ExecStart=/usr/bin/restic --password-file %h/.config/restic/password backup %h/stuff --exclude-file %h/.config/restic/excludes.txt --tag stuff
ExecStart=/usr/bin/restic --password-file %h/.config/restic/password backup %h/.ssh %h/.config/gh %h/.config/fish/fish_variables %h/.config/systemd/user %h/.config/restic --tag machine-state
ExecStart=/usr/bin/restic --password-file %h/.config/restic/password backup %h/.claude --tag claude \
  --exclude %h/.claude/cache --exclude %h/.claude/plugins/cache --exclude %h/.claude/plugins/marketplaces \
  --exclude %h/.claude/telemetry --exclude %h/.claude/debug --exclude %h/.claude/shell-snapshots \
  --exclude %h/.claude/session-env --exclude %h/.claude/file-history --exclude %h/.claude/.credentials.json
ExecStartPost=/usr/bin/restic --password-file %h/.config/restic/password forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
